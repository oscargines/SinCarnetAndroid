<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extracción de datos para Android 12+ (API 31+).
    Controla qué datos se incluyen en backups y transferencias de dispositivo.
    Ver: https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Incluir datos básicos de usuario -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />

        <!-- Excluir datos sensibles de atestados -->
        <exclude domain="sharedpref" path="device.xml"/>
        <exclude domain="sharedpref" path="settings.xml"/>
        <exclude domain="file" path="atestados/"/>
        <exclude domain="file" path="documents/"/>
        <exclude domain="file" path="temp/"/>
        <exclude domain="cache" path="." />

        <!-- Excluir datos de ubicación sensibles -->
        <exclude domain="sharedpref" path=".*location.*"/>
    </cloud-backup>

    <device-transfer>
        <!-- Para transferencia de dispositivo: incluir lo mismo que backup en nube -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />

        <exclude domain="sharedpref" path="device.xml"/>
        <exclude domain="sharedpref" path="settings.xml"/>
        <exclude domain="file" path="atestados/"/>
        <exclude domain="file" path="documents/"/>
        <exclude domain="file" path="temp/"/>
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
